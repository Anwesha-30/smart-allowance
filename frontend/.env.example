# Copy this file to .env and fill in values after running the deploy script.
# Never commit .env to version control.

# KidSafe contract address (printed by contracts/scripts/deploy.js)
VITE_KIDSAFE_CONTRACT_ADDRESS=

# MockUSDC token contract address (printed by deploy.js)
VITE_TOKEN_CONTRACT_ADDRESS=

# Chain ID — 31337 for local Hardhat network
VITE_CHAIN_ID=31337

# RPC URL for the local Hardhat node
VITE_RPC_URL=http://127.0.0.1:8545

# Set to "true" to force mock/demo mode even when MetaMask is connected
VITE_DEMO_MODE=false
